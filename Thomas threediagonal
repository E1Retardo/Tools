import numpy as np


def thomas_solve(a, b, c, d):
    """
    a, b, c - the three diagonal vectors. d - solution

    """
    
    a = np.asarray(a, dtype=float).copy()
    b = np.asarray(b, dtype=float).copy()
    c = np.asarray(c, dtype=float).copy()
    d = np.asarray(d, dtype=float).copy()

    n = len(d)
    if not (len(a) == len(b) == len(c) == n):
        raise ValueError("a, b, c, d must all have the same length")

    # --- Forward sweep: eliminate sub-diagonal ---
    
    c_prime = np.empty(n)
    d_prime = np.empty(n)

    if b[0] == 0:
        raise ZeroDivisionError("Zero pivot encountered at index 0")

    c_prime[0] = c[0] / b[0]
    d_prime[0] = d[0] / b[0]

    for i in range(1, n):
        m = b[i] - a[i] * c_prime[i - 1]
        if m == 0:
            raise ZeroDivisionError(
                f"Zero pivot encountered at index {i}; "
                "system may be singular or require pivoting"
            )
        c_prime[i] = c[i] / m
        d_prime[i] = (d[i] - a[i] * d_prime[i - 1]) / m

    # --- Back substitution ---
    x = np.empty(n)
    x[-1] = d_prime[-1]
    for i in range(n - 2, -1, -1):
        x[i] = d_prime[i] - c_prime[i] * x[i + 1]

    return x







import numpy as np


def thomas_solve(a, b, c, d):
    """Solve a tridiagonal system A x = d via the Thomas algorithm."""
    a = np.asarray(a, dtype=float).copy()
    b = np.asarray(b, dtype=float).copy()
    c = np.asarray(c, dtype=float).copy()
    d = np.asarray(d, dtype=float).copy()

    n = len(d)
    if not (len(a) == len(b) == len(c) == n):
        raise ValueError("a, b, c, d must all have the same length")
    if b[0] == 0:
        raise ZeroDivisionError("Zero pivot encountered at index 0")

    c_prime = np.empty(n)
    d_prime = np.empty(n)

    c_prime[0] = c[0] / b[0]
    d_prime[0] = d[0] / b[0]

    for i in range(1, n):
        m = b[i] - a[i] * c_prime[i - 1]
        if m == 0:
            raise ZeroDivisionError(
                f"Zero pivot encountered at index {i}; "
                "system may be singular or require pivoting"
            )
        c_prime[i] = c[i] / m
        d_prime[i] = (d[i] - a[i] * d_prime[i - 1]) / m

    x = np.empty(n)
    x[-1] = d_prime[-1]
    for i in range(n - 2, -1, -1):
        x[i] = d_prime[i] - c_prime[i] * x[i + 1]

    return x


def build_dense(a, b, c):
    """Reconstruct the full dense matrix from the three diagonals."""
    n = len(b)
    A = np.diag(b) + np.diag(a[1:], -1) + np.diag(c[:-1], 1)
    return A


def chebyshev_distance(u, v):
    """Chebyshev (L-infinity) distance: max_i |u[i] - v[i]|."""
    return float(np.max(np.abs(np.asarray(u) - np.asarray(v))))


def run_tests():
    rng = np.random.default_rng(0)

    # ---------- Test 1: small hand-checkable system ----------
    a = np.array([0., 1., 1.])
    b = np.array([2., 4., 2.])
    c = np.array([3., 1., 0.])
    d = np.array([5., 6., 3.])
    x = thomas_solve(a, b, c, d)
    print("Test 1 (hand-checked):", x, "-> expected [1, 1, 1]")
    assert np.allclose(x, [1., 1., 1.])

    # ---------- Test 2: agreement with numpy.linalg.solve ----------
    for n in [5, 20, 100, 500]:
        a = rng.uniform(-1, 1, n); a[0] = 0.0
        b = rng.uniform(3, 5, n)              # strictly diagonally dominant
        c = rng.uniform(-1, 1, n); c[-1] = 0.0
        d = rng.uniform(-10, 10, n)

        x_thomas = thomas_solve(a, b, c, d)
        A = build_dense(a, b, c)
        x_numpy = np.linalg.solve(A, d)

        err = chebyshev_distance(x_thomas, x_numpy)
        print(f"Test 2 (n={n:>3d}): Chebyshev distance to numpy solution = {err:.3e}")
        assert err < 1e-8, f"Test 2 FAILED at n={n}"

    # ---------- Test 3: DIRECT residual check via Chebyshev distance ----------
    # For each size, compute As and measure max|As - d|.
    print("\nTest 3: direct residual  max_i |(A s)[i] - d[i]|")
    for n in [2, 3, 5, 20, 100, 500, 2000]:
        a = rng.uniform(-2, 2, n); a[0] = 0.0
        b = rng.uniform(5, 8, n)              # strongly dominant => stable
        c = rng.uniform(-2, 2, n); c[-1] = 0.0
        d = rng.uniform(-5, 5, n)

        s = thomas_solve(a, b, c, d)
        A = build_dense(a, b, c)

        # As - d, then Chebyshev distance between As and d
        As = A @ s
        resid = chebyshev_distance(As, d)

        # Scale-relative version: divide by the magnitude of d
        rel = resid / max(1.0, np.max(np.abs(d)))

        print(f"  n={n:>4d}  |As - d|_inf = {resid:.3e}   "
              f"relative = {rel:.3e}")
        assert resid < 1e-8, f"Test 3 FAILED at n={n}"

    # ---------- Test 4: residual for a system with known exact solution ----------
    # Construct a system where we KNOW the answer, then verify the residual
    # is essentially zero (up to round-off).
    print("\nTest 4: known solution -> residual should be ~machine epsilon")
    for n in [10, 100, 1000]:
        a = rng.uniform(-1, 1, n); a[0] = 0.0
        b = rng.uniform(4, 6, n)
        c = rng.uniform(-1, 1, n); c[-1] = 0.0
        x_true = rng.uniform(-1, 1, n)

        A = build_dense(a, b, c)
        d = A @ x_true                        # <-- build RHS from the answer
        s = thomas_solve(a, b, c, d)

        resid = chebyshev_distance(A @ s, d)
        x_err = chebyshev_distance(s, x_true)

        print(f"  n={n:>4d}  |As - d|_inf = {resid:.3e}   "
              f"|s - x_true|_inf = {x_err:.3e}")
        # Residual is what the algorithm can guarantee; the solution error
        # additionally depends on cond(A).
        assert resid < 1e-10, f"Test 4 residual FAILED at n={n}"

    # ---------- Test 5: singular system should raise ----------
    a = np.array([0., 1., 1.])
    b = np.array([1., 1., 1.])
    c = np.array([1., 1., 0.])
    d = np.array([1., 1., 1.])
    try:
        thomas_solve(a, b, c, d)
        print("\nTest 5: no error raised (unexpected)")
    except ZeroDivisionError:
        print("\nTest 5: ZeroDivisionError raised as expected")

    print("\nAll tests passed ✅")


if __name__ == "__main__":
    run_tests()
